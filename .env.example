# Copy to .env and fill in ONE of these. See README.md.

# GitHub token (fine-grained, Contents: read-only) for PlaceOS/demo-data.
DEMO_DATA_TOKEN=

# Or: a local copy of the data repo. If set, the script does not use GitHub.
# DEMO_DATA_DIR=../demo-data

# Optional overrides.
# DEMO_DATA_REPO=PlaceOS/demo-data
# DEMO_DATA_REF=main
